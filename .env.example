APP_NAME=VitaeTex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_PORT=8000
VITE_PORT=5173
DB_FORWARD_PORT=5432
LOCAL_UID=1000
LOCAL_GID=1000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vitaetex
DB_USERNAME=vitaetex
DB_PASSWORD=vitaetex
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

TRUSTED_PROXIES=
TRUSTED_HOSTS=localhost
SECURITY_CSP_ENABLED=false
SECURITY_HSTS_MAX_AGE=0

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=database
# CACHE_PREFIX=

TECTONIC_BINARY=/usr/local/bin/tectonic
CV_PDF_TEMPORARY_ROOT=/tmp
CV_PDF_TEMPORARY_MAX_AGE_MINUTES=60
CV_PDF_TIMEOUT_SECONDS=30
CV_PDF_IDLE_TIMEOUT_SECONDS=15
CV_PDF_RATE_LIMIT_PER_MINUTE=3
CV_PDF_MAXIMUM_BYTES=5242880

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
